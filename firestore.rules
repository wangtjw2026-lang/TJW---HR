rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1 / Phase 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'wangtjw2026@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isRecruiterOrAdmin() {
      return isAdmin()
        || (isVerified()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hr_admin', 'recruiter']);
    }

    function isStaffListAllowed(data) {
      return isBootstrappedAdmin()
        || data.ownerId == request.auth.uid
        || request.auth.uid in data.assignedStaffIds;
    }

    function isValidBoundedStringList(arr, maxItems, maxItemLen) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= maxItemLen));
    }

    function isTerminalCandidateStatus(status) {
      return status in [
        'offer_accepted',
        'offer_rejected',
        'offer_expired',
        'rejected_screening',
        'not_qualified',
        'rejected_post_interview'
      ];
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS (Pillar 2 - Anti-Update-Gap)
    // =========================================================================
    function isValidStaffUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role in ['hr_admin', 'recruiter', 'hiring_manager']
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminEntry(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidCandidate(data) {
      return data.keys().hasAll([
          'candidateCode', 'fullName', 'maskedEmail', 'maskedPhone', 'emailHash', 'phoneHash',
          'positionApplied', 'department', 'source', 'applicationDate', 'currentStage', 'status',
          'aiMatchScore', 'aiSummary', 'educationSummary', 'experienceSummary', 'yearsExperience',
          'skills', 'screeningDecision', 'screeningRejectionReason', 'employmentFormCompleted',
          'discFormCompleted', 'discProfile', 'docSpmStatus', 'docUecStatus', 'docDegreeStatus',
          'docTranscriptStatus', 'lastDocReminderAt', 'qualificationDecision', 'qualificationRemarks',
          'interviewSlotId', 'interviewDate', 'interviewTime', 'interviewMode', 'interviewerName',
          'interviewFeedback', 'interviewRating', 'postInterviewDecision', 'offerStatus',
          'finalDecisionNotes', 'ownerId', 'assignedStaffIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'candidateCode', 'fullName', 'maskedEmail', 'maskedPhone', 'emailHash', 'phoneHash',
          'positionApplied', 'department', 'source', 'applicationDate', 'currentStage', 'status',
          'aiMatchScore', 'aiSummary', 'educationSummary', 'experienceSummary', 'yearsExperience',
          'skills', 'screeningDecision', 'screeningRejectionReason', 'employmentFormCompleted',
          'discFormCompleted', 'discProfile', 'docSpmStatus', 'docUecStatus', 'docDegreeStatus',
          'docTranscriptStatus', 'lastDocReminderAt', 'qualificationDecision', 'qualificationRemarks',
          'interviewSlotId', 'interviewDate', 'interviewTime', 'interviewMode', 'interviewerName',
          'interviewFeedback', 'interviewRating', 'postInterviewDecision', 'offerStatus',
          'finalDecisionNotes', 'ownerId', 'assignedStaffIds', 'createdAt', 'updatedAt'
        ])
        && data.candidateCode is string && data.candidateCode.size() >= 3 && data.candidateCode.size() <= 32
        && data.candidateCode.matches('^[A-Z0-9\\-]+$')
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 140
        && data.maskedEmail is string && data.maskedEmail.size() >= 3 && data.maskedEmail.size() <= 120
        && data.maskedPhone is string && data.maskedPhone.size() >= 3 && data.maskedPhone.size() <= 40
        && data.emailHash is string && data.emailHash.size() >= 8 && data.emailHash.size() <= 128
        && data.phoneHash is string && data.phoneHash.size() >= 8 && data.phoneHash.size() <= 128
        && data.positionApplied is string && data.positionApplied.size() >= 2 && data.positionApplied.size() <= 120
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && data.source is string && data.source in ['JobStreet', 'Email']
        && data.applicationDate is string && data.applicationDate.size() >= 10 && data.applicationDate.size() <= 30
        && data.currentStage is int && data.currentStage >= 1 && data.currentStage <= 15
        && data.status is string && data.status in [
          'new', 'pending_screening', 'shortlisted_docs', 'rejected_screening',
          'docs_under_review', 'qualified', 'not_qualified', 'interview_invited',
          'interview_confirmed', 'interview_completed', 'offer_sent', 'offer_pending',
          'offer_accepted', 'offer_rejected', 'offer_expired', 'rejected_post_interview'
        ]
        && data.aiMatchScore is int && data.aiMatchScore >= 0 && data.aiMatchScore <= 100
        && data.aiSummary is string && data.aiSummary.size() <= 1200
        && data.educationSummary is string && data.educationSummary.size() <= 600
        && data.experienceSummary is string && data.experienceSummary.size() <= 800
        && data.yearsExperience is number && data.yearsExperience >= 0 && data.yearsExperience <= 60
        && isValidBoundedStringList(data.skills, 20, 60)
        && data.screeningDecision is string && data.screeningDecision in ['pending', 'proceed', 'reject']
        && data.screeningRejectionReason is string && data.screeningRejectionReason.size() <= 500
        && data.employmentFormCompleted is bool
        && data.discFormCompleted is bool
        && data.discProfile is string && data.discProfile.size() <= 120
        && data.docSpmStatus is string && data.docSpmStatus in ['missing', 'submitted', 'verified']
        && data.docUecStatus is string && data.docUecStatus in ['not_applicable', 'missing', 'submitted', 'verified']
        && data.docDegreeStatus is string && data.docDegreeStatus in ['missing', 'submitted', 'verified']
        && data.docTranscriptStatus is string && data.docTranscriptStatus in ['missing', 'submitted', 'verified']
        && data.lastDocReminderAt is string && data.lastDocReminderAt.size() <= 40
        && data.qualificationDecision is string && data.qualificationDecision in ['pending', 'qualified', 'not_qualified']
        && data.qualificationRemarks is string && data.qualificationRemarks.size() <= 800
        && data.interviewSlotId is string && data.interviewSlotId.size() <= 128
        && data.interviewDate is string && data.interviewDate.size() <= 30
        && data.interviewTime is string && data.interviewTime.size() <= 40
        && data.interviewMode is string && data.interviewMode.size() <= 60
        && data.interviewerName is string && data.interviewerName.size() <= 120
        && data.interviewFeedback is string && data.interviewFeedback.size() <= 1500
        && data.interviewRating is int && data.interviewRating >= 0 && data.interviewRating <= 5
        && data.postInterviewDecision is string && data.postInterviewDecision in ['pending', 'offer', 'reject']
        && data.offerStatus is string && data.offerStatus in ['none', 'offer_sent', 'pending_response', 'accepted', 'rejected', 'expired']
        && data.finalDecisionNotes is string && data.finalDecisionNotes.size() <= 800
        && isValidId(data.ownerId)
        && isValidBoundedStringList(data.assignedStaffIds, 20, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivatePii(data) {
      return data.keys().hasAll([
          'email', 'phone', 'location', 'resumeFileName', 'resumeExcerpt',
          'spmFileName', 'uecFileName', 'degreeFileName', 'transcriptFileName',
          'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'email', 'phone', 'location', 'resumeFileName', 'resumeExcerpt',
          'spmFileName', 'uecFileName', 'degreeFileName', 'transcriptFileName',
          'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40
        && data.location is string && data.location.size() <= 120
        && data.resumeFileName is string && data.resumeFileName.size() <= 180
        && data.resumeExcerpt is string && data.resumeExcerpt.size() <= 4000
        && data.spmFileName is string && data.spmFileName.size() <= 180
        && data.uecFileName is string && data.uecFileName.size() <= 180
        && data.degreeFileName is string && data.degreeFileName.size() <= 180
        && data.transcriptFileName is string && data.transcriptFileName.size() <= 180
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateCompensation(data) {
      return data.keys().hasAll([
          'positionOffered', 'departmentOffered', 'monthlySalaryMYR', 'allowanceMYR',
          'probationMonths', 'startDate', 'offerDeadline', 'offerLetterRef',
          'offerTermsSummary', 'candidateResponseNote', 'respondedAt',
          'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'positionOffered', 'departmentOffered', 'monthlySalaryMYR', 'allowanceMYR',
          'probationMonths', 'startDate', 'offerDeadline', 'offerLetterRef',
          'offerTermsSummary', 'candidateResponseNote', 'respondedAt',
          'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.positionOffered is string && data.positionOffered.size() <= 120
        && data.departmentOffered is string && data.departmentOffered.size() <= 80
        && data.monthlySalaryMYR is number && data.monthlySalaryMYR >= 0 && data.monthlySalaryMYR <= 500000
        && data.allowanceMYR is number && data.allowanceMYR >= 0 && data.allowanceMYR <= 100000
        && data.probationMonths is int && data.probationMonths >= 0 && data.probationMonths <= 24
        && data.startDate is string && data.startDate.size() <= 30
        && data.offerDeadline is string && data.offerDeadline.size() <= 30
        && data.offerLetterRef is string && data.offerLetterRef.size() <= 120
        && data.offerTermsSummary is string && data.offerTermsSummary.size() <= 1500
        && data.candidateResponseNote is string && data.candidateResponseNote.size() <= 600
        && data.respondedAt is string && data.respondedAt.size() <= 40
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInterviewSlot(data) {
      return data.keys().hasAll([
          'date', 'startTime', 'endTime', 'interviewerName', 'department', 'mode',
          'meetingLinkOrRoom', 'status', 'bookedCandidateId', 'bookedCandidateName',
          'ownerId', 'assignedStaffIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'date', 'startTime', 'endTime', 'interviewerName', 'department', 'mode',
          'meetingLinkOrRoom', 'status', 'bookedCandidateId', 'bookedCandidateName',
          'ownerId', 'assignedStaffIds', 'createdAt', 'updatedAt'
        ])
        && data.date is string && data.date.size() >= 10 && data.date.size() <= 20
        && data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 20
        && data.endTime is string && data.endTime.size() >= 4 && data.endTime.size() <= 20
        && data.interviewerName is string && data.interviewerName.size() >= 2 && data.interviewerName.size() <= 120
        && data.department is string && data.department.size() >= 2 && data.department.size() <= 80
        && data.mode is string && data.mode in ['Google Meet', 'Microsoft Teams', 'On-site (KL HQ)', 'On-site (Penang)']
        && data.meetingLinkOrRoom is string && data.meetingLinkOrRoom.size() <= 250
        && data.status is string && data.status in ['available', 'booked', 'completed', 'cancelled']
        && data.bookedCandidateId is string && data.bookedCandidateId.size() <= 128
        && data.bookedCandidateName is string && data.bookedCandidateName.size() <= 140
        && isValidId(data.ownerId)
        && isValidBoundedStringList(data.assignedStaffIds, 20, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll([
          'candidateId', 'candidateName', 'maskedRecipient', 'templateType', 'subject',
          'bodyPreview', 'stageTriggered', 'deliveryStatus', 'triggeredByUid',
          'ownerId', 'assignedStaffIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'candidateId', 'candidateName', 'maskedRecipient', 'templateType', 'subject',
          'bodyPreview', 'stageTriggered', 'deliveryStatus', 'triggeredByUid',
          'ownerId', 'assignedStaffIds', 'createdAt'
        ])
        && isValidId(data.candidateId)
        && data.candidateName is string && data.candidateName.size() >= 1 && data.candidateName.size() <= 140
        && data.maskedRecipient is string && data.maskedRecipient.size() >= 3 && data.maskedRecipient.size() <= 120
        && data.templateType is string && data.templateType in [
          'shortlist_forms_disc', 'docs_reminder_48h', 'interview_invite',
          'interview_confirmation', 'employment_offer', 'rejection_notice'
        ]
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 200
        && data.bodyPreview is string && data.bodyPreview.size() >= 5 && data.bodyPreview.size() <= 2000
        && data.stageTriggered is int && data.stageTriggered >= 1 && data.stageTriggered <= 15
        && data.deliveryStatus is string && data.deliveryStatus in ['dispatched', 'queued']
        && isValidId(data.triggeredByUid)
        && isValidId(data.ownerId)
        && isValidBoundedStringList(data.assignedStaffIds, 20, 128)
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'actorUid', 'actorEmail', 'actorRole', 'action', 'targetType',
          'targetId', 'details', 'ownerId', 'assignedStaffIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'actorUid', 'actorEmail', 'actorRole', 'action', 'targetType',
          'targetId', 'details', 'ownerId', 'assignedStaffIds', 'createdAt'
        ])
        && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254
        && data.actorRole is string && data.actorRole in ['hr_admin', 'recruiter', 'hiring_manager']
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 100
        && data.targetType is string && data.targetType in ['candidate', 'pii', 'compensation', 'interview_slot', 'export', 'rbac']
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.details is string && data.details.size() >= 2 && data.details.size() <= 500
        && isValidId(data.ownerId)
        && isValidBoundedStringList(data.assignedStaffIds, 20, 128)
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. Staff Users & RBAC Profiles
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerified() && (isBootstrappedAdmin() || existing().uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(userId)
        && isValidStaffUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrappedAdmin() && isOwner(userId))
          || (isOwner(userId) && incoming().role in ['recruiter', 'hiring_manager'] && incoming().email == request.auth.token.email)
          || isAdmin()
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidStaffUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Admin updates role or department
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'department', 'displayName', 'updatedAt']))
          // Action: User updates own displayName/department only (cannot elevate role)
          || (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt']))
        );

      allow delete: if false;
    }

    // 2. Trusted HR Admin Registry
    match /admins/{userId} {
      allow get: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && isValidAdminEntry(incoming())
        && incoming().uid == userId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(userId) && isBootstrappedAdmin();
    }

    // 3. Core Candidate Pipeline Collection
    match /candidates/{candidateId} {
      allow get: if isVerified()
        && isValidId(candidateId)
        && (isAdmin() || existing().ownerId == request.auth.uid || request.auth.uid in existing().assignedStaffIds);

      allow list: if isVerified() && isStaffListAllowed(existing());

      allow create: if isVerified()
        && isValidId(candidateId)
        && isValidCandidate(incoming())
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().assignedStaffIds
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isRecruiterOrAdmin() || isOwner(incoming().ownerId));

      allow update: if isVerified()
        && isValidId(candidateId)
        && isValidCandidate(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().candidateCode == existing().candidateCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!isTerminalCandidateStatus(existing().status) || isAdmin())
        && (
          // Action: Admin full workflow update (non-immutable fields)
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'maskedEmail', 'maskedPhone', 'emailHash', 'phoneHash',
            'positionApplied', 'department', 'source', 'applicationDate', 'currentStage', 'status',
            'aiMatchScore', 'aiSummary', 'educationSummary', 'experienceSummary', 'yearsExperience',
            'skills', 'screeningDecision', 'screeningRejectionReason', 'employmentFormCompleted',
            'discFormCompleted', 'discProfile', 'docSpmStatus', 'docUecStatus', 'docDegreeStatus',
            'docTranscriptStatus', 'lastDocReminderAt', 'qualificationDecision', 'qualificationRemarks',
            'interviewSlotId', 'interviewDate', 'interviewTime', 'interviewMode', 'interviewerName',
            'interviewFeedback', 'interviewRating', 'postInterviewDecision', 'offerStatus',
            'finalDecisionNotes', 'assignedStaffIds', 'updatedAt'
          ]))
          // Action: Stage 3-4 Initial Screening Decision (Recruiter / Owner)
          || ((isRecruiterOrAdmin() || isOwner(existing().ownerId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStage', 'status', 'screeningDecision', 'screeningRejectionReason', 'updatedAt'
            ]))
          // Action: Stage 5-8 Documents, Google Apps Script Forms, Reminders & Qualification (Recruiter / Owner)
          || ((isRecruiterOrAdmin() || isOwner(existing().ownerId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStage', 'status', 'employmentFormCompleted', 'discFormCompleted', 'discProfile',
              'docSpmStatus', 'docUecStatus', 'docDegreeStatus', 'docTranscriptStatus',
              'lastDocReminderAt', 'qualificationDecision', 'qualificationRemarks', 'updatedAt'
            ]))
          // Action: Stage 9-10 Interview Invite & Atomic Slot Booking (Recruiter / Owner)
          || ((isRecruiterOrAdmin() || isOwner(existing().ownerId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStage', 'status', 'interviewSlotId', 'interviewDate', 'interviewTime',
              'interviewMode', 'interviewerName', 'updatedAt'
            ]))
          // Action: Stage 11-12 Interview Evaluation & Post-Interview Decision (Hiring Manager / Recruiter / Owner)
          || ((isOwner(existing().ownerId) || request.auth.uid in existing().assignedStaffIds)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStage', 'status', 'interviewFeedback', 'interviewRating',
              'postInterviewDecision', 'finalDecisionNotes', 'updatedAt'
            ]))
          // Action: Stage 13-15 Employment Offer Status Tracking (Admin)
          || (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentStage', 'status', 'offerStatus', 'finalDecisionNotes', 'updatedAt'
            ]))
        );

      allow delete: if isVerified() && isValidId(candidateId) && isAdmin();

      // 3A. PDPA Split Subcollection: Private PII & Academic Docs (Masked from Hiring Managers)
      match /private/pii {
        allow get: if isVerified()
          && isValidId(candidateId)
          && exists(/databases/$(database)/documents/candidates/$(candidateId))
          && (isAdmin() || (isRecruiterOrAdmin() && (
            get(/databases/$(database)/documents/candidates/$(candidateId)).data.ownerId == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/candidates/$(candidateId)).data.assignedStaffIds
          )));

        allow list: if false;

        allow create: if isVerified()
          && isValidId(candidateId)
          && isValidPrivatePii(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/candidates/$(candidateId))
          && (isRecruiterOrAdmin() || isOwner(incoming().ownerId));

        allow update: if isVerified()
          && isValidId(candidateId)
          && isValidPrivatePii(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/candidates/$(candidateId))
          && (isAdmin() || (isRecruiterOrAdmin() && isOwner(existing().ownerId)))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'phone', 'location', 'resumeFileName', 'resumeExcerpt',
            'spmFileName', 'uecFileName', 'degreeFileName', 'transcriptFileName', 'updatedAt'
          ]);

        allow delete: if isVerified() && isValidId(candidateId) && isAdmin();
      }

      // 3B. PDPA Split Subcollection: Private Compensation & MYR Offer Terms (Strictly HR Admin)
      match /private/compensation {
        allow get: if isVerified()
          && isValidId(candidateId)
          && exists(/databases/$(database)/documents/candidates/$(candidateId))
          && isAdmin();

        allow list: if false;

        allow create: if isVerified()
          && isValidId(candidateId)
          && isValidPrivateCompensation(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/candidates/$(candidateId))
          && isAdmin();

        allow update: if isVerified()
          && isValidId(candidateId)
          && isValidPrivateCompensation(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/candidates/$(candidateId))
          && isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'positionOffered', 'departmentOffered', 'monthlySalaryMYR', 'allowanceMYR',
            'probationMonths', 'startDate', 'offerDeadline', 'offerLetterRef',
            'offerTermsSummary', 'candidateResponseNote', 'respondedAt', 'updatedAt'
          ]);

        allow delete: if isVerified() && isValidId(candidateId) && isAdmin();
      }
    }

    // 4. Interview Slots (Atomic Locking via getAfter)
    match /interviewSlots/{slotId} {
      allow get: if isVerified()
        && isValidId(slotId)
        && (isAdmin() || existing().ownerId == request.auth.uid || request.auth.uid in existing().assignedStaffIds);

      allow list: if isVerified() && isStaffListAllowed(existing());

      allow create: if isVerified()
        && isValidId(slotId)
        && isValidInterviewSlot(incoming())
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().assignedStaffIds
        && incoming().status == 'available'
        && incoming().bookedCandidateId == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isRecruiterOrAdmin() || isOwner(incoming().ownerId));

      allow update: if isVerified()
        && isValidId(slotId)
        && isValidInterviewSlot(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Atomic Slot Booking (Pillar 7 Atomicity Guarantee via getAfter)
          (existing().status == 'available'
            && incoming().status == 'booked'
            && isValidId(incoming().bookedCandidateId)
            && getAfter(/databases/$(database)/documents/candidates/$(incoming().bookedCandidateId)).data.interviewSlotId == slotId
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bookedCandidateId', 'bookedCandidateName', 'updatedAt']))
          // Action 2: Mark Interview Completed
          || (existing().status == 'booked'
            && incoming().status == 'completed'
            && (isAdmin() || isOwner(existing().ownerId) || request.auth.uid in existing().assignedStaffIds)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          // Action 3: Release / Cancel Slot (Admin or Recruiter/Owner)
          || ((isAdmin() || isRecruiterOrAdmin() || isOwner(existing().ownerId))
            && incoming().status in ['available', 'cancelled']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bookedCandidateId', 'bookedCandidateName', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(slotId) && (isAdmin() || isOwner(existing().ownerId));
    }

    // 5. Automated Email Dispatch Logs (Append-Only)
    match /emailLogs/{logId} {
      allow get: if isVerified()
        && isValidId(logId)
        && (isAdmin() || existing().ownerId == request.auth.uid || request.auth.uid in existing().assignedStaffIds);

      allow list: if isVerified() && isStaffListAllowed(existing());

      allow create: if isVerified()
        && isValidId(logId)
        && isValidEmailLog(incoming())
        && incoming().triggeredByUid == request.auth.uid
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().assignedStaffIds
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/candidates/$(incoming().candidateId));

      allow update: if false;
      allow delete: if false;
    }

    // 6. Immutable Malaysian PDPA Security Audit Logs (Append-Only)
    match /auditLogs/{logId} {
      allow get: if isVerified()
        && isValidId(logId)
        && (isAdmin() || existing().ownerId == request.auth.uid);

      allow list: if isVerified() && isStaffListAllowed(existing());

      allow create: if isVerified()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().assignedStaffIds
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }
  }
}
