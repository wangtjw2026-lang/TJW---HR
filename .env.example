# Server Configuration
PORT=3000
# Publicly accessible base URL for outbound Candidate Self-Service Portal links (emails & WhatsApp)
# Do NOT use a private AI Studio preview link (ais-dev-...), which external candidates cannot open.
PUBLIC_APP_URL=""

# Turso Cloud SQLite (libSQL) — leave blank to fall back to local SQLite (data/talentflow.db)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Google Drive Apps Script Webhook URL for persistent file storage — leave blank to fall back to local uploads/
GOOGLE_DRIVE_WEBHOOK_URL=""

# Optional VAKAD Online Assessment Link (HTTPS) — leave blank while VAKAD is not yet created
VAKAD_FORM_URL=""

# Authentication (change in production)
JWT_SECRET="change-this-to-a-strong-random-secret"

# GEMINI_API_KEY: Required for Gemini AI resume parsing & scoring.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional Gemini model override (defaults to gemini-3.1-flash-lite with gemini-4-hydrogen fallback)
GEMINI_MODEL="gemini-3.1-flash-lite"

# Live Gmail SMTP Configuration for Nodemailer (configure in Settings > Secrets)
# Use your Gmail address as SMTP_USER and a 16-character Google App Password as SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TalentFlow MY HR <your-email@gmail.com>"
