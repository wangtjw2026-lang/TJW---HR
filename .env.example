# Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Authentication (change in production)
JWT_SECRET="change-this-to-a-strong-random-secret"

# GEMINI_API_KEY: Required for Gemini AI resume parsing & scoring.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional Gemini model override (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Optional SMTP Configuration for Nodemailer (falls back to email_logs + console if unset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TalentFlow MY HR <hr@company.com>"

