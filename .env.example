# Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Authentication (change in production)
JWT_SECRET="change-this-to-a-strong-random-secret"

# GEMINI_API_KEY: Required for Gemini AI resume parsing & scoring.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional Gemini model override (defaults to gemini-3.1-flash-lite with gemini-4-hydrogen fallback)
GEMINI_MODEL="gemini-3.1-flash-lite"

# Live Gmail SMTP Configuration for Nodemailer (configure in Settings > Secrets)
# Use your Gmail address as SMTP_USER and a 16-character Google App Password as SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TalentFlow MY HR <your-email@gmail.com>"

